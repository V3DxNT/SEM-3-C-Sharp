secrets.json

# Ignore .NET Core tooling files
.project.lock.json
project.lock.json
project.fragment.lock.json
artifacts/

# Ignore local NuGet packages
*.nupkg
*.snupkg
.nuget/

# Ignore build logs
*.log

# Ignore test results
TestResults/
*.vsmdi
*.testsettings
*.vsp
*.vspscc
*.cache
*.pdb
*.mdb

# Ignore temporary files
*.tmp
*.bak
*.old
*.orig
*.swn
*.swp
*.swo

# Ignore OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Ignore environment-specific files
.env
